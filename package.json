{
  "name": "ebook-store",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "migrate": "npm run migrate -w server",
    "create-admin": "npm run create-admin -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
