NODE_ENV=development
PORT=4000

# Public address customers reach the site on. UddoktaPay redirects back here.
# In development this is the Vite server, which proxies /api to Express.
PUBLIC_URL=http://localhost:5173
# Number of reverse proxies in front of Express (0 if none).
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ebook_store
DB_PASSWORD=change-me
DB_NAME=ebook_store

# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Sandbox values from UddoktaPay's docs. In production use your installation's
# URL (e.g. https://pay.your-domain.com) and the API key from its dashboard.
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com
UDDOKTAPAY_API_KEY=982d381360a69d419689740d9f2e26ce36fb7a50
